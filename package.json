{
  "name": "vite-plugin-pug-to-html",
  "version": "0.1.0",
  "description": "Vite plugin that compiles Pug to HTML files for backends, mailers and servers, in worker threads while the bundle builds",
  "keywords": [
    "html",
    "pug",
    "static",
    "templates",
    "vite",
    "vite-plugin"
  ],
  "homepage": "https://github.com/imamatory/vite-plugin-pug-to-html#readme",
  "bugs": "https://github.com/imamatory/vite-plugin-pug-to-html/issues",
  "license": "MIT",
  "author": "Vadim Safonov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imamatory/vite-plugin-pug-to-html.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt --check",
    "knip": "knip",
    "check": "pnpm run build && pnpm run typecheck && pnpm run lint && pnpm run format && pnpm run knip && pnpm test && pnpm pack --dry-run",
    "fix": "oxlint --fix && oxfmt",
    "commitlint": "commitlint --from origin/main --to HEAD"
  },
  "dependencies": {
    "fast-glob": "^3.3.3",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^22.20.5",
    "knip": "^6.45.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "pug": "^3.0.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "peerDependencies": {
    "pug": "^3.0.0",
    "vite": ">=5.0.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@12.21.0"
}
